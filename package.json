{
  "name": "wms-rm",
  "private": true,
  "scripts": {
    "dev": "docker compose -f docker-compose.dev.yml up -d && npm run dev:be & npm run dev:fe",
    "dev:backend": "npm run start:dev --prefix rm/backend",
    "dev:frontend": "npm run dev --prefix rm/frontend",
    "dev:be": "npm run start:dev --prefix rm/backend",
    "dev:fe": "npm run dev --prefix rm/frontend",
    "dev:down": "docker compose -f docker-compose.dev.yml down",
    "prod": "docker compose up -d --build",
    "prod:down": "docker compose down"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@floating-ui/react": "^0.27.20",
    "@floating-ui/react-dom": "^2.1.9"
  }
}
